# Copy to .env and fill in. Only the token is required.

# Your member token — one per person, the same on every machine you own.
# Get one at https://simhive.app/join (or in the app: Settings → Pool → Get a token).
SIMHIVE_TOKEN=

# true  = the interface on port 4747 (your own Localbots page: sims go to the pool) AND this machine's cores lent to the pool
# false = cores only, no page (threads / schedule / pause for it are set from the app, Settings → Pool)
SIMHIVE_INTERFACE=true

# How this machine appears in the pool (default: the container's host name)
SIMHIVE_NAME=

# The port the interface is served on (ignored when SIMHIVE_INTERFACE=false)
SIMHIVE_PORT=4747

# Optional: Blizzard API credentials for live Armory lookups on the Armory tab
# (free at https://develop.battle.net/access/clients). Without them the tab uses
# a public scan; pasting the /simc export always works.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
